{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-faire.local/contracts/product.schema.json",
  "title": "Product",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_id", "brand_id", "name", "category", "unit_price", "unit_cost", "inventory_count", "is_active"],
  "properties": {
    "product_id": {"type": "string", "pattern": "^prd_[0-9]+$"},
    "brand_id": {"type": "string", "pattern": "^br_[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "unit_price": {"type": "number", "minimum": 0},
    "unit_cost": {"type": "number", "minimum": 0},
    "inventory_count": {"type": "integer", "minimum": 0},
    "is_active": {"type": "boolean"}
  }
}

