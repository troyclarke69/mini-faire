{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Order Shipped Event",
  "type": "object",
  "properties": {
    "event_id": { "type": "string" },
    "event_type": { "type": "string", "enum": ["orders_shipped"] },
    "order_id": { "type": "string" },
    "carrier": { "type": "string" },
    "event_ts": { "type": "string", "format": "date-time" }
  },
  "required": ["event_id", "event_type", "order_id", "carrier", "event_ts"]
}
