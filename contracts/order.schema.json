{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-faire.local/contracts/order.schema.json",
  "title": "Order",
  "type": "object",
  "additionalProperties": false,
  "required": ["order_id", "retailer_id", "product_id", "order_ts", "quantity", "gross_amount", "discount_amount", "status"],
  "properties": {
    "order_id": {"type": "string", "pattern": "^ord_[0-9]+$"},
    "retailer_id": {"type": "string", "pattern": "^ret_[0-9]+$"},
    "product_id": {"type": "string", "pattern": "^prd_[0-9]+$"},
    "order_ts": {"type": "string", "format": "date-time"},
    "quantity": {"type": "integer", "minimum": 1},
    "gross_amount": {"type": "number", "minimum": 0},
    "discount_amount": {"type": "number", "minimum": 0},
    "status": {"type": "string", "enum": ["created", "paid", "shipped", "cancelled"]}
  }
}

