# Python
__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
pytest-cache-files-*/
*.egg-info/

# DuckDB warehouse - regenerated by ingestion/load_duckdb.py,
# ingestion/tenant_ingest.py, scripts/run_demo.py, etc.
*.duckdb
*.duckdb.wal

# All generated/synthetic data: raw + warehouse + ML model artifacts +
# streaming state (see ingestion/paths.py's DATA_DIR).
data/

# Frontend
frontend/node_modules/
frontend/.next/

# Environment files - real secrets/connection strings live here locally,
# never commit them. *.env.example files are templates and ARE meant to be
# committed (not matched by the patterns below).
.env
.env.local
.env.*.local

# Terraform local state/vars (infra/cloud/terraform/) - can contain resolved
# secrets or resource identifiers once actually applied. terraform.tfvars.example
# is a template and stays tracked.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# OS / editor cruft
.DS_Store
Thumbs.db

# Personal scratch notes never meant for the repo - named explicitly rather
# than a blanket *.txt/*.md rule, which would also hide real documentation
# (see this review's notes: PHASE1-8*.md were never committed because of
# exactly that).
DoNOTpUSH.txt
